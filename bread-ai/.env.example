# Bread configuration. Copy to .env and edit.
#
#   cp .env.example .env         (Linux/macOS)
#   copy .env.example .env       (Windows)
#
# Every value here has a working default, so an empty .env still boots. A YAML
# profile (BREAD_CONFIG_FILE) can set the same keys; a real environment variable
# always wins over the profile.

# =============================================================== server
BREAD_HOST=127.0.0.1
BREAD_PORT=8000
BREAD_LOG_LEVEL=info
BREAD_DATA_DIR=data
# Leave empty to use data/bread.db
BREAD_DATABASE_URL=
BREAD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# =============================================================== security
# Bread binds to localhost by default, where a key is optional. Binding to a LAN
# address forces key checks on regardless of this setting.
BREAD_REQUIRE_API_KEY=false
# Set true only when you have read docs/SECURITY.md and meant to expose Bread.
BREAD_ALLOW_LAN_BINDING=false
BREAD_RATE_LIMIT_REQUESTS=120
BREAD_RATE_LIMIT_WINDOW=60
BREAD_MAX_UPLOAD_BYTES=26214400

# =============================================================== model
# Start with 'mock' so nothing downloads. Switch to 'transformers', 'llama_cpp'
# or 'openai_compat' when you are ready.
MODEL_BACKEND=mock
MODEL_ID=Qwen/Qwen2.5-Coder-7B-Instruct
# Empty means "same as MODEL_ID"
TOKENIZER_ID=
MODEL_DEVICE=auto
MODEL_DTYPE=bfloat16
# none | 8bit | 4bit
QUANTIZATION_MODE=4bit
MAX_CONTEXT_LENGTH=8192
MAX_NEW_TOKENS=1024
TEMPERATURE=0.2
TOP_P=0.95
REPETITION_PENALTY=1.05
# Directory produced by a training run, the one holding adapter_config.json
ADAPTER_PATH=
SYSTEM_PROMPT_PATH=prompts/system_default.md
TRUST_REMOTE_CODE=false
# Bread will not fetch weights that are not already cached unless this is true
# or the load request sets confirm_download.
ALLOW_MODEL_DOWNLOAD=false
MOCK_DELAY_SECONDS=0.01

# ------- llama.cpp / GGUF (MODEL_BACKEND=llama_cpp)
GGUF_MODEL_PATH=
GGUF_N_GPU_LAYERS=-1

# ------- OpenAI-compatible local server (MODEL_BACKEND=openai_compat)
OPENAI_COMPAT_BASE_URL=http://127.0.0.1:8080/v1
OPENAI_COMPAT_API_KEY=not-needed
OPENAI_COMPAT_MODEL=

# =============================================================== RAG
RAG_ENABLED=true
RAG_TOP_K=5
RAG_RERANK_ENABLED=false
RAG_RERANK_MODEL_ID=cross-encoder/ms-marco-MiniLM-L-6-v2
EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
# auto | sentence_transformers | hashing
# 'auto' uses sentence-transformers when the model is cached and falls back to
# Bread's built-in hashing encoder when it is not.
EMBEDDING_BACKEND=auto
# numpy | chroma
VECTOR_BACKEND=numpy
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150

# ============================================================== memory
# What Bread remembers between conversations. Entries are plain rows in the
# same local SQLite file; nothing is inferred without you asking for it.
MEMORY_ENABLED=true
# How many non-pinned entries may reach one prompt. Pinned entries are added
# on top of this.
MEMORY_RECALL_LIMIT=8
# Check the Python in a reply for invented APIs and let the model correct
# itself before you see the answer. Costs one extra generation per round, and
# never executes the code.
VERIFY_CODE_DEFAULT=false
VERIFY_CODE_ATTEMPTS=3

# =============================================================== paths
TRAINING_OUTPUT_DIR=runs
DATASETS_DIR=datasets
