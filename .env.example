# Discord bot token from https://discord.com/developers/applications
BOT_TOKEN=

# OpenRouter API key from https://openrouter.ai/keys, powers the /ask, /roast, /trivia, /wyr, /8ball
# and /compliment commands in cogs/ai.py. Those commands degrade to an error message if unset.
OPENROUTER_API_KEY=

# OpenRouter model slug to use for AI commands. Defaults to a Kimi model if unset.
OPENROUTER_MODEL=moonshotai/kimi-k2
